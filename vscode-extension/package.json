{
  "name": "agy-project-hub",
  "displayName": "Antigravity Project Hub",
  "description": "Live multi-session & fork lineage explorer, interactive context trajectory chart, status bar context meter, and CLI session manager for Google Antigravity.",
  "version": "1.0.0",
  "publisher": "iamqazolp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agyProjectHub",
          "title": "Antigravity Project Hub",
          "icon": "media/hub-icon.svg"
        }
      ]
    },
    "views": {
      "agyProjectHub": [
        {
          "id": "agyProjectHub.sessionsView",
          "name": "Sessions, Forks & Subagents"
        },
        {
          "id": "agyProjectHub.artifactsView",
          "name": "Knowledge Base & Git Telemetry"
        }
      ]
    },
    "commands": [
      {
        "command": "agyProjectHub.openDashboard",
        "title": "Antigravity: Open Project Hub Visual Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "agyProjectHub.openHubMarkdown",
        "title": "Antigravity: Open PROJECT_HUB.md",
        "icon": "$(markdown)"
      },
      {
        "command": "agyProjectHub.refresh",
        "title": "Antigravity: Sync & Refresh Project Hub",
        "icon": "$(sync)"
      },
      {
        "command": "agyProjectHub.resumeSessionInCli",
        "title": "Resume Session in agy CLI",
        "icon": "$(terminal)"
      },
      {
        "command": "agyProjectHub.copySessionId",
        "title": "Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "agyProjectHub.copyResumeCommand",
        "title": "Copy 'agy --conversation <id>'",
        "icon": "$(clippy)"
      },
      {
        "command": "agyProjectHub.selectSessionInDashboard",
        "title": "Inspect Session in Visual Dashboard",
        "icon": "$(pulse)"
      },
      {
        "command": "agyProjectHub.openArtifact",
        "title": "Open Artifact",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agyProjectHub.openDashboard",
          "when": "view == agyProjectHub.sessionsView || view == agyProjectHub.artifactsView",
          "group": "navigation@1"
        },
        {
          "command": "agyProjectHub.openHubMarkdown",
          "when": "view == agyProjectHub.sessionsView || view == agyProjectHub.artifactsView",
          "group": "navigation@2"
        },
        {
          "command": "agyProjectHub.refresh",
          "when": "view == agyProjectHub.sessionsView || view == agyProjectHub.artifactsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agyProjectHub.resumeSessionInCli",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "inline@1"
        },
        {
          "command": "agyProjectHub.copySessionId",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "inline@2"
        },
        {
          "command": "agyProjectHub.resumeSessionInCli",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "1_cli@1"
        },
        {
          "command": "agyProjectHub.copyResumeCommand",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "1_cli@2"
        },
        {
          "command": "agyProjectHub.copySessionId",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "1_cli@3"
        },
        {
          "command": "agyProjectHub.selectSessionInDashboard",
          "when": "view == agyProjectHub.sessionsView && viewItem =~ /^session\\b/",
          "group": "2_inspect@1"
        }
      ],
      "editor/title": [
        {
          "command": "agyProjectHub.openDashboard",
          "when": "resourceFilename == PROJECT_HUB.md",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Project Hub",
      "properties": {
        "agyProjectHub.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically watch Antigravity brain transcripts and Git state to keep PROJECT_HUB.md and the status bar context meter updated in real time."
        },
        "agyProjectHub.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to run the local_recap telemetry scanner."
        }
      }
    }
  }
}
